# Configuration for docker-compose.yml (production stack). See docs/deployment.md.
#
#   cp .env.docker.example .env        # on the deployment host
#   docker compose up -d --build
#
# There are NO defaults. Every value marked REQUIRED must be filled in: an empty one makes
# `docker compose` stop with a message naming it. Never commit the filled-in file.
# If you keep this next to a development .env, use `docker compose --env-file .env.docker ...`
# on every command (or export COMPOSE_ENV_FILES=.env.docker).

# =============================================================================
# Network exposure
# =============================================================================

# REQUIRED. Interface the container ports are published on.
#   127.0.0.1  -> reachable only from the host; put a TLS reverse proxy (Caddy, nginx) in front
#   0.0.0.0    -> reachable from anywhere; only if something else already provides TLS
BIND_ADDRESS=

# =============================================================================
# Public URLs. NEXT_PUBLIC_* are compiled into the web apps at build time, so changing them
# means rebuilding: docker compose up -d --build
# =============================================================================

# REQUIRED. Public URL of the API including the /api prefix, as browsers reach it.
NEXT_PUBLIC_API_URL=
# REQUIRED. Public URLs of the web apps (no trailing slash).
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_BLOG_URL=
NEXT_PUBLIC_HACKER_URL=

# REQUIRED. Public URL of the admin panel and of the hacker portal (GitHub login redirects here).
ADMIN_URL=
HACKER_PORTAL_URL=

# REQUIRED. Origins the API accepts browser requests from: the public URLs of all four web apps,
# comma-separated, no trailing slashes.
CORS_ORIGIN=

# =============================================================================
# Database
# =============================================================================

# REQUIRED. MongoDB connection string. A managed database, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sos-academy?retryWrites=true&w=majority
# or, with docker-compose.mongo.yml,
#   mongodb://<MONGO_ROOT_USERNAME>:<MONGO_ROOT_PASSWORD>@mongo:27017/sos-academy?authSource=admin
MONGODB_URI=

# Only when using docker-compose.mongo.yml (REQUIRED in that case, and applied only when the data
# volume is first created):
# MONGO_ROOT_USERNAME=
# MONGO_ROOT_PASSWORD=

# =============================================================================
# Secrets (REQUIRED). Generate each one separately, e.g. `openssl rand -base64 48`.
# =============================================================================

JWT_SECRET=
JWT_REFRESH_SECRET=
SESSION_SECRET=

# Resend API key, from https://resend.com/api-keys. The API refuses to start without it.
RESEND_API_KEY=

# Admin account seeded on first start.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# =============================================================================
# GitHub OAuth app (REQUIRED). https://github.com/settings/developers
# =============================================================================

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of the API's callback, e.g. https://api.example.org/api/auth/github/callback.
# Must match the callback URL configured on the GitHub OAuth app.
GITHUB_CALLBACK_URL=

# =============================================================================
# Optional. Uncomment to set; when unset the API's own behaviour applies.
# =============================================================================

# APP_URL=                    # public URL of the API, used in logs
# EMAIL_FROM=                 # must be verified in Resend
# LOG_LEVEL=
# JWT_EXPIRATION=
# JWT_REFRESH_EXPIRATION=
# GITHUB_API_TOKEN=           # raises the GitHub API rate limit
# GITHUB_ORG_NAME=            # auto-invite approved members to this GitHub organisation
# GITHUB_ORG_ADMIN_TOKEN=

# Discord bot (docker compose --profile bot up -d). The bot checks these itself on start.
# DISCORD_BOT_TOKEN=
# DISCORD_GENERAL_CHANNEL_ID=
# DISCORD_MENTORS_CHANNEL_ID=
# REMINDER_CRON=
# TIMEZONE=
# DRY_RUN=
