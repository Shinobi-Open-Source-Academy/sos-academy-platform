{
  "name": "@sos-academy-platform/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "turbo run dev --filter=server",
    "dev:backend": "turbo run dev --filter=server",
    "dev:admin": "turbo run dev --filter=admin",
    "dev:website": "turbo run dev --filter=website",
    "dev:blog": "turbo run dev --filter=blog",
    "dev:hacker": "turbo run dev --filter=hacker",
    "dev:kunai-bot": "turbo run dev --filter=kunai-bot",
    "dev:admin:full": "concurrently --kill-others-on-fail --prefix-colors \"bgBlue.bold,bgGreen.bold\" \"pnpm:dev:backend\" \"pnpm:dev:admin\"",
    "dev:blog:full": "concurrently --kill-others-on-fail --prefix-colors \"bgBlue.bold,bgGreen.bold\" \"pnpm:dev:backend\" \"pnpm:dev:blog\"",
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=server",
    "build:admin": "turbo run build --filter=admin",
    "build:website": "turbo run build --filter=website",
    "build:hacker": "turbo run build --filter=hacker",
    "build:kunai-bot": "turbo run build --filter=kunai-bot",
    "build:shared": "turbo run build --filter=@sos-academy/shared",
    "start": "turbo run start",
    "start:backend": "turbo run start --filter=server",
    "start:backend:prod": "node dist/apps/server/main.js",
    "start:admin": "turbo run start --filter=admin",
    "start:website": "turbo run start --filter=website",
    "start:hacker": "turbo run start --filter=hacker",
    "start:kunai-bot": "turbo run start --filter=kunai-bot",
    "kunai-bot:preview": "pnpm --filter kunai-bot preview",
    "kunai-bot:send-now": "pnpm --filter kunai-bot send-now",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:all": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "prepare": "husky || true",
    "seed": "cd apps/server && pnpm build:dev && node ../../dist/apps/server/main.js seed",
    "seed:clear": "cd apps/server && pnpm build:dev && node ../../dist/apps/server/main.js clear",
    "seed:reset": "cd apps/server && pnpm build:dev && node ../../dist/apps/server/main.js reset",
    "seed:status": "cd apps/server && pnpm build:dev && node ../../dist/apps/server/main.js status",
    "seed:admin": "curl -X POST ${API_URL:-http://localhost:4200}/api/seeder/admin/seed",
    "seed:admin:reset": "curl -X POST ${API_URL:-http://localhost:4200}/api/seeder/admin/reset",
    "clean": "rm -rf dist apps/*/dist apps/*/node_modules apps/*/.next apps/*/out libs/*/dist node_modules .turbo *.turbo coverage tmp out-tsc && echo '✅ Cleaned build artifacts and caches'",
    "clean:and:install": "pnpm clean && pnpm install"
  },
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "^10.0.2",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.7.9",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/node": "18.16.9",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^11.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "lint-staged": "^15.2.10",
    "postcss": "^8.5.6",
    "prettier": "^2.6.2",
    "tailwindcss": "^3.4.18",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.1",
    "ts-node": "10.9.1",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "turbo": "^2.9.14",
    "typescript": "~5.7.2",
    "webpack": "^5.104.1",
    "webpack-cli": "^5.1.4",
    "webpack-node-externals": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.1.12",
      "koa@>=3.0.1 <3.0.3": ">=3.0.3",
      "validator": ">=13.15.22",
      "nodemailer": ">=10.0.13",
      "glob": ">=10.5.0",
      "qs": "^6.16.0",
      "js-yaml": "^4.3.2",
      "html-minifier": "npm:html-minifier-terser@^7.2.0",
      "liquidjs": "^10.27.2",
      "brace-expansion@<1.1.21": "^1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "^2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "^5.0.12",
      "shell-quote": "^1.9.0",
      "form-data": ">=4.0.6",
      "@babel/core": ">=7.29.6",
      "tmp": ">=0.2.6",
      "@xhmikosr/decompress@<10.2.2": "^10.2.2",
      "@isaacs/brace-expansion@<5.0.1": "^5.0.1",
      "browserslist@<4.28.7": "^4.28.7",
      "baseline-browser-mapping@<2.11.0": "^2.11.0",
      "deepmerge-ts@<8.0.0": "^8.0.2",
      "fast-uri@<3.1.8": "^3.1.8",
      "ajv@<6.14.0": "^6.14.0",
      "ajv@>=7.0.0 <8.18.0": "^8.18.0",
      "immutable@>=5.0.0 <5.1.8": "^5.1.8",
      "js-cookie@<3.0.7": "^3.0.7",
      "linkify-it@<5.0.2": "^5.0.2",
      "lodash@<4.18.0": "^4.18.1",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "minimatch@>=10.0.0 <10.2.3": "^10.2.3",
      "multer@<2.3.0": "^2.4.0",
      "nanoid@<3.3.18": "^3.3.18",
      "path-to-regexp@<0.1.13": "^0.1.13",
      "body-parser@<1.20.6": "^1.20.6",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "piscina@<4.9.3": "^4.9.3",
      "postcss@<8.5.23": "^8.5.23",
      "postcss-selector-parser@>=6.1.0 <6.1.3": "^6.1.3",
      "serialize-javascript@<7.0.5": "^7.0.5",
      "sharp@<0.35.4": "^0.35.4",
      "svgo@>=4.0.0 <4.1.0": "^4.1.0",
      "undici@<6.28.1": "^6.28.1",
      "undici@>=7.0.0 <7.29.1": "^7.29.1",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "fflate@<0.8.3": "^0.8.3",
      "uuid@<11.1.1": "^11.1.1",
      "yaml@<1.10.3": "^1.10.3",
      "yaml@>=2.0.0 <2.8.3": "^2.8.3",
      "yauzl@<3.2.1": "^3.2.1",
      "@tootallnate/once@<2.0.1": "^2.0.1",
      "diff@>=4.0.0 <4.0.4": "^4.0.4",
      "webpack@>=5.49.0 <5.104.1": "^5.104.1"
    }
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.3.6",
    "@nestjs/cli": "^10.0.2",
    "@nestjs/common": "^10.0.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/swagger": "^7.4.2",
    "@sos-academy/shared": "workspace:*",
    "@vercel/analytics": "^1.6.1",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0-rc.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "css-select": "^5.1.0",
    "dotenv": "^17.2.3",
    "handlebars": "^4.7.9",
    "mongoose": "^8.24.4",
    "next": "16.3.8",
    "nodemailer": "^10.0.13",
    "nth-check": "^2.1.1",
    "react": "19.0.0",
    "react-countup": "^6.5.3",
    "react-dom": "19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "reflect-metadata": "^0.1.13",
    "resend": "^6.6.0",
    "rxjs": "^7.8.0",
    "swagger-ui-express": "^5.0.0",
    "tslib": "^2.3.0"
  }
}
